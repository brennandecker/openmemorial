{
  "name": "openmemorial",
  "compatibility_date": "2026-11-06",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    "run_worker_first": [
      "/share/*",
      "/memories/*.mp4",
      "/api/*",
      "/family",
      "/family/*"
    ]
  },
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  },
  "main": "src/videoWorker.ts",
  "d1_databases": [
    {
      "binding": "NOTES",
      "database_name": "memorial-wall-notes",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [
    {
      "name": "NOTE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 10,
        "period": 60
      }
    }
  ],
  "workers_dev": true,
  "vars": {
    "SUBMISSIONS_ENABLED": "false",
    "PHOTO_UPLOADS_ENABLED": "false"
  }
}
